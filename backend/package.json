{
  "name": "chess-training-backend",
  "version": "1.0.0",
  "description": "Chess Training POC - Backend API Server",
  "main": "dist/app.js",
  "scripts": {
    "start": "ts-node src/app.ts",
    "dev": "nodemon src/app.ts",
    "build": "tsc",
    "seed": "ts-node src/scripts/seed.ts",
    "backup-database": "ts-node src/scripts/backup-database.ts",
    "restore-database": "ts-node src/scripts/restore-database.ts",
    "cleanup-duplicates": "ts-node src/scripts/cleanup-duplicates.ts",
    "migrate-full": "cd ../tools && npm run build && npm run migrate-all-data && npm run migrate-all-puzzles && cd ../backend && npm run cleanup-duplicates && npm run backup-database"
  },
  "dependencies": {
    "bcrypt": "^5.1.x",
    "chess.js": "^1.0.x",
    "cors": "^2.8.x",
    "dotenv": "^16.3.x",
    "express": "^4.18.x",
    "express-validator": "^7.0.x",
    "helmet": "^7.0.x",
    "jsonwebtoken": "^9.0.x",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.6",
    "typescript": "^5.0.x",
    "uuid": "^9.0.x"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.x",
    "@types/cors": "^2.8.x",
    "@types/express": "^4.17.x",
    "@types/jsonwebtoken": "^9.0.x",
    "@types/node": "^20.0.x",
    "@types/uuid": "^9.0.x",
    "concurrently": "^9.2.0",
    "nodemon": "^3.0.x",
    "ts-node": "^10.9.x"
  },
  "keywords": [
    "chess",
    "training",
    "backend",
    "api",
    "poc"
  ],
  "author": "",
  "license": "MIT"
}
